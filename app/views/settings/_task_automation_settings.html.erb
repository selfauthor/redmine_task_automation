<%# ============================================================================ %>
<%# Файл: app/views/settings/_task_automation_settings.html.erb %>
<%# ============================================================================ %>

<%# Инициализация переменных, если они не установлены %>
<% @projects ||= Project.active.sorted %>
<% @users ||= User.active.sorted %>
<% @trackers ||= Tracker.sorted %>
<% @groups ||= Group.sorted %>
<% @settings ||= Setting.plugin_redmine_task_automation %>

<fieldset class="box tabular">
  <legend><%= I18n.t('task_automation.settings.section_main') %></legend>
  
  <p>
    <%= label_tag 'settings[source_project_id]', I18n.t('task_automation.settings.source_project_id') %><br/>
    <%= select_tag 'settings[source_project_id]',
        options_from_collection_for_select(@projects, 'id', 'name', @settings[:source_project_id]),
        include_blank: I18n.t('task_automation.settings.select_project'),
        class: 'settings-select' %>
    <span class="ta-info"><%= I18n.t('task_automation.settings.source_project_hint') %></span>
  </p>
  
  <p>
    <%= label_tag 'settings[author_id]', I18n.t('task_automation.settings.author_id') %><br/>
    <%= select_tag 'settings[author_id]',
        options_from_collection_for_select(@users, 'id', 'name', @settings[:author_id]),
        include_blank: I18n.t('task_automation.settings.select_user'),
        class: 'settings-select' %>
    <span class="ta-info"><%= I18n.t('task_automation.settings.author_hint') %></span>
  </p>
  
  <p>
    <%= label_tag 'settings[tracker_id]', I18n.t('task_automation.settings.tracker_id') %><br/>
    <%= select_tag 'settings[tracker_id]',
        options_from_collection_for_select(@trackers, 'id', 'name', @settings[:tracker_id]),
        include_blank: I18n.t('task_automation.settings.select_tracker'),
        class: 'settings-select' %>
    <span class="ta-info"><%= I18n.t('task_automation.settings.tracker_hint') %></span>
  </p>
  
  <p>
    <%= label_tag 'settings[error_notification_email]', I18n.t('task_automation.settings.error_notification_email') %><br/>
    <%= text_field_tag 'settings[error_notification_email]', @settings[:error_notification_email],
        class: 'settings-text', size: 50 %>
    <span class="ta-info"><%= I18n.t('task_automation.settings.email_hint') %></span>
  </p>
</fieldset>

<fieldset class="box tabular">
  <legend><%= I18n.t('task_automation.settings.section_actions') %></legend>
  
  <p>
    <%= submit_tag I18n.t('task_automation.buttons.test'),
        name: 'test_settings',
        class: 'button-neutral',
        data: { confirm: I18n.t('task_automation.confirm.test') } %>
    <span class="ta-info"><%= I18n.t('task_automation.buttons.test_hint') %></span>
  </p>
  
  <p>
    <%= submit_tag I18n.t('task_automation.buttons.run_now'),
        name: 'run_now',
        class: 'button-positive',
        data: { confirm: I18n.t('task_automation.confirm.run_now') } %>
    <span class="ta-info"><%= I18n.t('task_automation.settings.run_now_hint') %></span>
  </p>
</fieldset>

<%# Секция: Результаты тестирования (если есть) %>
<% if session[:task_automation_test_results].present? %>
<fieldset class="box tabular">
  <legend><%= I18n.t('task_automation.settings.section_test_results') %></legend>
  
  <table class="list settings-test-results">
    <thead>
      <tr>
        <th><%= I18n.t('task_automation.test.status') %></th>
        <th><%= I18n.t('task_automation.test.message') %></th>
      </tr>
    </thead>
    <tbody>
      <% session[:task_automation_test_results].each do |result| %>
        <tr class="<%= result[:status] %>">
          <td class="status">
            <% case result[:status] %>
            <% when 'success' %>
              <span class="icon icon-check"></span> <%= I18n.t('task_automation.status.success') %>
            <% when 'error' %>
              <span class="icon icon-error"></span> <%= I18n.t('task_automation.status.error') %>
            <% when 'warning' %>
              <span class="icon icon-warning"></span> <%= I18n.t('task_automation.status.warning') %>
            <% else %>
              <span class="icon icon-info"></span> <%= I18n.t('task_automation.status.info') %>
            <% end %>
          </td>
          <td><%= result[:message].html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</fieldset>
<% end %>

<%# Секция: Информация о последнем запуске %>
<% if File.exist?(Rails.root.join('log', 'task_automation.log')) %>
<fieldset class="box tabular">
  <legend><%= I18n.t('task_automation.settings.section_last_run') %></legend>
  
  <% begin %>
    <% last_lines = IO.readlines(Rails.root.join('log', 'task_automation.log')).last(10) %>
    <% if last_lines.any? %>
      <div class="log-preview">
        <% last_lines.each do |line| %>
          <div class="log-line <%= line.include?('ERROR') ? 'error' : line.include?('WARN') ? 'warning' : 'info' %>">
            <%= line.strip %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="ta-info"><%= I18n.t('task_automation.log.empty') %></p>
    <% end %>
  <% rescue => e %>
    <p class="error"><%= I18n.t('task_automation.log.read_error', error: e.message) %></p>
  <% end %>
</fieldset>
<% else %>
<fieldset class="box tabular">
  <legend><%= I18n.t('task_automation.settings.section_last_run') %></legend>
  <p class="ta-info"><%= I18n.t('task_automation.log.empty') %></p>
</fieldset>
<% end %>

<style>
  .settings-select { min-width: 300px; }
  .settings-text { width: 300px; }
  .settings-test-results tr.success { background-color: #dff0d8; }
  .settings-test-results tr.error { background-color: #f2dede; }
  .settings-test-results tr.warning { background-color: #fcf8e3; }
  .log-preview {
    max-height: 300px;
    overflow-y: auto;
    background-color: #f5f5f5;
    border: 1px solid #ddd;
    padding: 10px;
    font-family: monospace;
    font-size: 12px;
  }
  .log-line { padding: 2px 0; border-bottom: 1px solid #eee; }
  .log-line.error { color: #a94442; }
  .log-line.warning { color: #8a6d3b; }
  .log-line.info { color: #333; }
  fieldset.box.tabular { margin-bottom: 20px; padding: 15px; }
  fieldset.box.tabular legend { font-weight: bold; padding: 0 10px; }
  .ta-info { display: block; margin-top: 5px; color: #666; font-size: 12px; font-style: italic; }
</style>